<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WolvenKit.Linux.ViewModels"
        xmlns:svc="using:WolvenKit.Linux.Services"
        x:Class="WolvenKit.Linux.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="WolvenKit" Width="1200" Height="760" MinWidth="700" MinHeight="400">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
      <TextBlock Text="Game:" VerticalAlignment="Center" />
      <ComboBox x:Name="InstallBox" ItemsSource="{Binding Installs}" SelectedItem="{Binding SelectedInstall}"
                MinWidth="420" AutomationProperties.Name="Game install" />
      <Button x:Name="AddGameButton" Content="Add game folder…" Click="OnAddGameFolder" />
      <Button x:Name="OpenArchiveButton" Content="Open archive…" Click="OnOpenArchive" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="120" />
        <TextBlock x:Name="StatusText" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="320,4,*" Margin="8,0,8,8">
      <ListBox x:Name="ArchiveList" Grid.Column="0" ItemsSource="{Binding Archives}" SelectedItem="{Binding SelectedArchive}"
               AutomationProperties.Name="Archives">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding Converter={x:Static vm:FileNameConverter.Instance}}" ToolTip.Tip="{Binding}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <DockPanel Grid.Column="2">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button x:Name="ExtractButton" DockPanel.Dock="Right" Margin="8,0,0,0" Content="Extract selected…" Click="OnExtract" />
          <TextBox x:Name="FilterBox" Text="{Binding Filter}" PlaceholderText="Filter files (path contains)…" AutomationProperties.Name="Filter" />
        </DockPanel>
        <ListBox x:Name="EntryList" ItemsSource="{Binding Entries}" SelectionMode="Multiple" AutomationProperties.Name="Files">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="svc:ArchiveEntry">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Opacity="0.6" Margin="12,0,0,0" />
                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
